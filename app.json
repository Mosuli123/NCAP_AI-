{
  "expo": {
    "sdkVersion": "52.0.0",
    "newArchEnabled": true,
    "name": "Khetha NCAP",
    "slug": "khetha-ncap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "khethancap",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B4F6C"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "za.gov.dhet.khethancap",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "za.gov.dhet.khethancap",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B4F6C"
      },
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#0B4F6C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "ncapApiBaseUrl": "https://ncap.careerhelp.org.za/api"
    }
  }
}
